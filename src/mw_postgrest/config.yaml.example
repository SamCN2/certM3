# Logging configuration
# Global log level (debug, info, warn, error)
log_level: info
log_file: /var/log/certM3/mw/app.log
# Enable verbose logging to stdout
verbose: false

# Middleware configuration (shared between app and signer)
middleware:
  # Shared socket path for app-signer communication
  socket_path: "/var/spool/certM3/signer/signer.sock"

# App server configuration
app_server:
  listen_addr: ":8080"
  frontend_baseurl: "https://your-domain.com/app"
  backend_baseurl: "https://your-domain.com/api"
  # Will be loaded from /var/spool/certM3/mw/JWT-secret
  jwt_secret: ""
  rate_limit_per_ip: 100
  metrics_enabled: true
  metrics_path: "/metrics"
  metrics_timeout: 5s
  test_email_dir: "/var/spool/certM3/test-emails/"

# Signer configuration
signer:
  # CA configuration (only used by signer)
  ca_cert_path: "../../CA/certs/ca-cert.pem"
  ca_key_path: "../../CA/private/ca-key.pem"
  group_extension_oid: "1.3.6.1.4.1.10049.6.5.1.1.1"
  # Groups extension OID (enterprises.webrelay.security.pki.certificates.extensions.groupNameExtension)
  # username_extension_oid removed - username is now only in CN

  # Certificate subject fields
  subject_ou: "CertM3"
  subject_o: "your-organization.com"
  subject_l: "City"
  subject_st: "State"
  subject_c: "US"

  # Certificate validity and URLs
  cert_validity_days: 365
  crl_distribution_url: "https://your-domain.com/crl/ca.crl"
  aia_issuer_url: "https://your-domain.com/certs/ca-cert.pem"

  # Extension OIDs
  # role_extension_oid removed - not used by signer
  # username_extension_oid removed - username is now only in CN

  # Key usage settings
  key_usage: ["digitalSignature", "keyEncipherment"]
  extended_key_usage: ["clientAuth", "serverAuth"]
